{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README-START-HERE.txt", "takoyonke-app-original.html", "firebase-config.example.js", "firebase-init.example.js", "firestore.rules"],
